[Unit]
Description=Claude session pool %i (new sessions from the Claude app / claude.ai/code)
After=network-online.target
ConditionPathExists=%h/projects/%i

[Service]
EnvironmentFile=-%h/.config/nori/claude.env
ExecStart=%h/.local/bin/claude-pool %i
Restart=always
RestartSec=20
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
