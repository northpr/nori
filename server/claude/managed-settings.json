{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "ask": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/nori/server/bin/push-guard"
          }
        ]
      }
    ]
  }
}
