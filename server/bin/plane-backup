#!/bin/bash
# Nightly Plane DB dump, keep the last 7.
set -o pipefail
cd ~/plane || exit 1
out=~/backups/plane/plane-$(date +%Y%m%d).sql.gz
docker compose --env-file plane.env exec -T plane-db sh -c 'PGPASSWORD=$POSTGRES_PASSWORD pg_dump -h 127.0.0.1 -U $POSTGRES_USER $POSTGRES_DB' | gzip > "$out.tmp" && mv "$out.tmp" "$out" || { rm -f "$out.tmp"; echo "$(date) backup FAILED" >&2; exit 1; }
ls -1t ~/backups/plane/plane-*.sql.gz | tail -n +8 | xargs -r rm -f
echo "$(date) backup ok $(du -h "$out" | cut -f1)"
