#!/bin/bash
# Cron (as the admin user, time = HANDOFF_TIME): ask each idle Claude session to write its handoff
# (HANDOFF.md), wait for it, then restart the session so the day starts with a clean context.
# Sessions run as their own Linux users (one per area); busy ones are skipped for the night.
set -u
echo "=== $(date "+%F %T") nightly-handoff start"
# shellcheck disable=SC1091
. "$HOME/nori/scripts/conf.sh" || exit 1
# shellcheck disable=SC1090
. "$NORI_ROOT/chat/$CHAT/platform.conf"
OPS="$HOME/.local/bin/ops-bot"
report=()
# seconds until the next AUTO_REBOOT_TIME (default 04:30), so a long queue of areas never runs into the update reboot
secs_to_reboot() {
  local t=${AUTO_REBOOT_TIME:-04:30} now target
  now=$(date +%s); target=$(date -d "today $t" +%s)
  (( target < now )) && target=$(date -d "tomorrow $t" +%s)
  echo $(( target - now ))
}
as() { local u=$1; shift; sudo -n -u "$u" -H env XDG_RUNTIME_DIR="/run/user/$(id -u "$u")" "$@"; }
for a in $AREAS; do
  id "$a" >/dev/null 2>&1 || continue
  h=$(area_home "$a")
  as "$a" test -f "$h/.claude/channels/${CHAT_STATE_PREFIX}${a}/${CHAT_TOKEN_FILE}" || continue
  if (( $(secs_to_reboot) < 720 )); then report+=("⏭ $a skipped: too close to the update reboot"); continue; fi
  st=$(python3 -I "$OPS" state "$a")
  if [[ $st != idle ]]; then report+=("⏭ $a skipped (was $st)"); continue; fi
  f="$h/projects/$a/HANDOFF.md"
  before=$(as "$a" stat -c %Y "$f" 2>/dev/null || echo 0)
  t="claude-$a"
  as "$a" tmux -L "$t" send-keys -t "$t" C-u
  as "$a" tmux -L "$t" send-keys -t "$t" -l "Nightly handoff: do the 'Fresh start each night' steps from ~/projects/CLAUDE.md now (overwrite $f). Reply only here in the terminal with 'handoff done', not in the chat."
  as "$a" tmux -L "$t" send-keys -t "$t" Enter
  after=$before
  for _ in $(seq 1 60); do            # up to 10 minutes
    sleep 10
    after=$(as "$a" stat -c %Y "$f" 2>/dev/null || echo 0)
    [[ $after -gt $before && "$(python3 -I "$OPS" state "$a")" == idle ]] && break
  done
  if [[ $after -gt $before ]]; then
    as "$a" systemctl --user restart "claude@$a" && report+=("🌙 $a: handoff saved, fresh start ✅")
  else
    report+=("⚠️ $a: no handoff after 10 min, not restarted")
  fi
done
(( ${#report[@]} )) && "$OPS" send "$(printf '%s\n' "${report[@]}")"
exit 0
