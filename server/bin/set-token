#!/bin/bash
# Put a bot token on this server WITHOUT it ever touching a chat, a shell history or a process list.
#   set-token <area>   token of the chat bot of that area (written for the area's Linux user)
#   set-token ops      token of the Ops bot (~/.ops-bot.env)
#   set-token plane    Plane API key (~/.plane-mcp.env, copied to the areas by setup.sh)
# Run as the admin user. You are prompted for the secret; typing is hidden.
set -euo pipefail
# shellcheck disable=SC1091
. "$HOME/nori/scripts/conf.sh"
# shellcheck disable=SC1090
. "$NORI_ROOT/chat/$CHAT/platform.conf"
what="${1:?usage: set-token <area|ops|plane>}"
read -rsp "Paste the secret for '$what' (hidden), then Enter: " tok; echo
[[ -n $tok ]] || { echo "empty, nothing written" >&2; exit 1; }
umask 077
case "$what" in
  ops)
    printf 'OPS_BOT_TOKEN=%s\n' "$tok" > "$HOME/.ops-bot.env"
    echo "wrote ~/.ops-bot.env (mode 600). Next: ./setup.sh (starts the ops-bot service)" ;;
  plane)
    printf 'PLANE_API_KEY=%s\n' "$tok" > "$HOME/.plane-mcp.env"
    echo "wrote ~/.plane-mcp.env (mode 600). Next: ./setup.sh (copies it to the area users)" ;;
  *)
    case " $AREAS " in *" $what "*) ;; *) echo "unknown area '$what' (AREAS=\"$AREAS\")" >&2; exit 2 ;; esac
    dir=".claude/channels/${CHAT_STATE_PREFIX}${what}"
    printf '%s=%s\n' "$CHAT_TOKEN_KEY" "$tok" | sudo -u "$what" -H bash -c \
      "umask 077; mkdir -p \"\$HOME/$dir\" && cat > \"\$HOME/$dir/$CHAT_TOKEN_FILE\""
    echo "wrote the token for '$what' (mode 600, owned by $what). Next: ./setup.sh (starts claude@$what)" ;;
esac
