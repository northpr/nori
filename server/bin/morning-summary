#!/usr/bin/env bash
# morning-summary — daily repo digest sent to the ops chat (cron: DIGEST_TIME in nori.conf).
# Without an Ops bot (OPS_BOT=false) it goes to the owner's DM through the first area's chat bot.
#
# Flow: collect git/gh facts deterministically -> summarize with `claude -p`
# (sonnet, no tools, subscription auth) -> send via `ops-bot send`. If claude fails,
# the raw facts are sent instead. Repos are read-only (only `git fetch`).
#
# Log: ~/logs/morning-summary.log (the bot token is never written there).
# Flags: --dry-run  collect + summarize, print, but don't send.

set -uo pipefail

export PATH="$HOME/.local/bin:$HOME/.bun/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# shellcheck disable=SC1091
. "$HOME/nori/scripts/conf.sh" || exit 1
LOG_DIR="$HOME/logs"
LOG="$LOG_DIR/morning-summary.log"
SEARCH_ROOTS=("$HOME/projects")
DRY_RUN=0; FACTS_ONLY=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1
# --facts-only: run as an area user to print the git facts for its own ~/projects
[[ "${1:-}" == "--facts-only" ]] && FACTS_ONLY=1
read -ra AREA_USERS <<<"$AREAS"   # Linux users that own the Claude sessions and their repos

mkdir -p "$LOG_DIR"
(( FACTS_ONLY )) && LOG=/dev/null
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }

START=$(date +%s)
(( FACTS_ONLY )) || log "=== run start (dry_run=$DRY_RUN) ==="

# ---------- 1. collect facts ----------
FACTS="Date: $(date '+%A %Y-%m-%d %H:%M %Z')"$'\n'

repo_facts() {
  local dir="$1" name branch upstream behind ahead dirty last prs issues
  name="${dir#"$HOME"/projects/}"
  cd "$dir" || return
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
  timeout 60 git fetch -q 2>/dev/null || log "fetch failed: $name"
  if upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
    read -r behind ahead < <(git rev-list --left-right --count "$upstream...HEAD" 2>/dev/null || echo "? ?")
  else
    upstream="(no upstream)"; behind="?"; ahead="?"
  fi
  dirty=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  last=$(git log -1 --format='%cr (%cd) — %s' --date=format:'%Y-%m-%d' 2>/dev/null || echo "none")

  if prs=$(timeout 60 gh pr list --limit 10 --json number,title,isDraft 2>/dev/null); then
    prs=$(jq -r 'if length==0 then "none" else map("#\(.number) \(.title)\(if .isDraft then " [draft]" else "" end)") | join("; ") end' <<<"$prs")
  else
    prs="gh unavailable"
  fi
  if issues=$(timeout 60 gh issue list --limit 10 --json number,title 2>/dev/null); then
    issues=$(jq -r 'if length==0 then "0" else "\(length)\(if length==10 then "+" else "" end): " + (map("#\(.number) \(.title)") | join("; ")) end' <<<"$issues")
  else
    issues="gh unavailable"
  fi

  FACTS+=$'\n'"== $name =="$'\n'
  FACTS+="branch: $branch (upstream $upstream) | behind: $behind | ahead: $ahead | uncommitted files: $dirty"$'\n'
  FACTS+="last commit: $last"$'\n'
  FACTS+="open PRs: $prs"$'\n'
  FACTS+="open issues: $issues"$'\n'
}

mapfile -t REPOS < <(
  for root in "${SEARCH_ROOTS[@]}"; do
    [[ -d "$root" ]] && find "$root" -maxdepth 4 -name .git -prune -printf '%h\n' 2>/dev/null
  done | sort -u
)
log "repos found: ${#REPOS[@]}"
for r in "${REPOS[@]}"; do repo_facts "$r"; done
if (( FACTS_ONLY )); then printf '%s' "$FACTS" | tail -n +2; exit 0; fi
# repos of the area users (their homes aren't readable by dev, so they report themselves)
for u in "${AREA_USERS[@]}"; do
  id "$u" >/dev/null 2>&1 || continue
  FACTS+=$(sudo -n -u "$u" -H /opt/nori/server/bin/morning-summary --facts-only 2>>"$LOG")$'\n'
done
grep -q '^== ' <<<"$FACTS" || FACTS+=$'\n'"(no repos found)"$'\n'

collect_plane_facts() {
  local envf="$HOME/.plane-mcp.env" key base pj
  is_on PLANE || return 0
  [[ -f $envf ]] || return 0
  key=$(sed -n 's/^PLANE_API_KEY=//p' "$envf")
  base="http://$TAILNET_HOST/api/v1/workspaces/$PLANE_WORKSPACE"
  pj=$(curl -s -m 15 -H "X-API-Key: $key" "$base/projects/") || { FACTS+=$'\n'"== Plane =="$'\n'"(unreachable)"$'\n'; return 0; }
  FACTS+=$'\n'"== Plane tickets (open: in progress / todo / backlog) =="$'\n'
  while IFS=$'\t' read -r pid ident pname; do
    [[ -n $pid ]] || continue
    local items
    items=$(curl -s -m 15 -H "X-API-Key: $key" "$base/projects/$pid/work-items/?expand=state,labels,module&per_page=100" \
      | jq -r --arg id "$ident" '.results // [] | map(select(.state.group as $g | ($g != "completed" and $g != "cancelled")))
          | sort_by({"started":0,"unstarted":1,"backlog":2}[.state.group] // 3)
          | if length == 0 then "  (none)" else (.[:12][] | "  \($id)-\(.sequence_id) [\(.state.name)] \(.name) (priority: \(.priority); labels: \([.labels[]?.name? // empty] | join(", ")))") end')
    FACTS+="$pname ($ident):"$'\n'"$items"$'\n'
  done < <(jq -r '.results[] | [.id, .identifier, .name] | @tsv' <<<"$pj")
}
collect_plane_facts

log "facts collected in $(( $(date +%s) - START ))s"

# ---------- 2. summarize with claude ----------
PROMPT="You write a short morning digest for a developer, read on a phone in a chat app.
Below are facts about their git repos (and possibly other sections such as tickets).
Write:
- per repo: 1-3 short lines (repo name first with an emoji; mention branch only if not main/master, behind/ahead/uncommitted only if non-zero, open PRs/issues, how fresh the last commit is). Note 'gh unavailable' briefly if present.
- if there are Plane tickets: one 'Tickets' line counting open tickets by involvement label (🤖 auto = Claude can do alone, ⚡ quick-ask = waiting for a quick answer, 🧠 needs-me = waiting for the owner's decision), then list the ⚡ and 🧠 ones by id and title (they need the owner).
- then a line 'Suggested focus today' followed by at most 3 bullets (suggest 'send: do the auto tickets' when there are 🤖 tickets).
Rules: plain text only, a few emojis, no markdown (no **, no #, no tables), written in $DIGEST_LANGUAGE, under 1500 characters total. Output only the digest.

FACTS:
$FACTS"

SUMMARY=""
CLAUDE_START=$(date +%s)
# Neutral cwd so no project CLAUDE.md is loaded; no tools, no MCP servers, no session saved.
WORKDIR=$(mktemp -d)
if SUMMARY=$(cd "$WORKDIR" && timeout 300 claude -p \
      --model sonnet \
      --permission-mode dontAsk \
      --tools "" \
      --strict-mcp-config \
      --no-session-persistence \
      <<<"$PROMPT" 2>>"$LOG") && [[ -n "${SUMMARY//[[:space:]]/}" ]]; then
  log "claude ok in $(( $(date +%s) - CLAUDE_START ))s (${#SUMMARY} chars)"
  MESSAGE="☀️ Morning summary"$'\n\n'"$SUMMARY"
else
  log "claude failed (exit $?) after $(( $(date +%s) - CLAUDE_START ))s — sending raw facts"
  MESSAGE="☀️ Morning summary (raw facts — claude unavailable)"$'\n\n'"$FACTS"
fi
rm -rf "$WORKDIR"

# ---------- 3. send ----------
log "message:"; printf "%s\n" "$MESSAGE" | sed "s/^/    /" >>"$LOG"
if (( DRY_RUN )); then
  printf '%s\n' "$MESSAGE"
  log "dry run — not sent; total $(( $(date +%s) - START ))s"
  exit 0
fi

# Delivery: `ops-bot send` uses the Ops bot, or the first area's chat bot when there is none (splits long messages).
if printf '%s\n' "$MESSAGE" | "$HOME/.local/bin/ops-bot" send - >>"$LOG" 2>&1; then
  log "sent; total $(( $(date +%s) - START ))s"
  exit 0
fi
log "ERROR: send failed (Ops bot: is ~/.ops-bot.env present? Without one: does the first area have its bot token?)"
exit 1
