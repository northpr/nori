#!/bin/bash
# git credential helper: return the gh token for the requested GitHub username.
[ "$1" = get ] || exit 0
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in host=*) host=${line#host=};; username=*) user=${line#username=};; esac
done
[ "$host" = github.com ] || [ "$host" = gist.github.com ] || exit 0
[ -n "$user" ] || user=$(/usr/bin/gh api user --jq .login 2>/dev/null)
tok=$(/usr/bin/gh auth token --user "$user" 2>/dev/null) || exit 0
printf "username=%s\npassword=%s\n" "$user" "$tok"
