#!/bin/bash
# Attach to a Claude session's tmux: attach [area]   (detach: Ctrl+b then d, never Ctrl+d or /exit)
# Each session runs as its own Linux user (named after the area); the admin attaches via sudo.
# Restart a session without the Ops bot: sudo -u <area> XDG_RUNTIME_DIR=/run/user/$(id -u <area>) systemctl --user restart claude@<area>
# shellcheck disable=SC1091
. "$HOME/nori/scripts/conf.sh" 2>/dev/null || AREAS="main"
a="${1:-${AREAS%% *}}"
infocmp "$TERM" >/dev/null 2>&1 || export TERM=xterm-256color
if [[ $(id -un) == "$a" ]]; then tmux -L "claude-$a" has-session -t "claude-$a" 2>/dev/null; else sudo -u "$a" -H tmux -L "claude-$a" has-session -t "claude-$a" 2>/dev/null; fi || {
  echo "No Claude session for $a yet (is claude@$a running? see docs/troubleshooting.md)" >&2; exit 1; }
echo "Connecting to Claude ($a). Leave with Ctrl+b then d — not Ctrl+d or /exit, those quit Claude." >&2
if [[ $(id -un) == "$a" ]]; then
  tmux -L "claude-$a" attach -t "claude-$a"; rc=$?
  alive() { tmux -L "claude-$a" has-session -t "claude-$a" 2>/dev/null; }
else
  # the area user may not see the admin's ~/.terminfo: check as that user too
  sudo -u "$a" -H env TERM="$TERM" infocmp >/dev/null 2>&1 || export TERM=xterm-256color
  sudo -u "$a" -H env TERM="$TERM" tmux -L "claude-$a" attach -t "claude-$a"; rc=$?
  alive() { sudo -u "$a" -H tmux -L "claude-$a" has-session -t "claude-$a" 2>/dev/null; }
fi
if alive; then
  echo "↩ Left the session. Claude keeps running in the background. Back in: run the same attach command again."
else
  echo "Claude stopped (Ctrl+d or /exit quits it). It restarts by itself in about 10 s with a fresh conversation."
fi
exit "$rc"
